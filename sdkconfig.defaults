# --- Board: Waveshare ESP32-S3, 32 MB octal flash + 16 MB octal PSRAM (checked with esptool) ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Firmware updates over the network (main/fw_update.c) ---
# If freshly updated firmware crashes before it has run for a few seconds, the bootloader
# goes back to the firmware that was running before.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Logs go to UART0 (the separate USB-serial chip). TinyUSB owns the built-in USB. ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- USB network device (CDC-NCM) ---
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="TikPrint"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="TikPrint"

# --- mDNS (the tikprint.local name) ---
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_PREDEF_NETIF_AP=n

# --- Network connections ("sockets") the board can have open at once ---
# The web server may hold 7 for browsers and needs 3 itself, and the USB network uses 1. With the
# default of 10 that left none for the board's own calls out (weather, firmware updates) while a
# page was open in a busy browser.
CONFIG_LWIP_MAX_SOCKETS=16

# --- Memory for secure connections (TLS) ---
# A linked printer keeps up to three secure connections open at once (the Realtime socket, the
# printer's row, TikPrint Cloud), next to the ones that come and go (weather, firmware updates).
# Each needs a 16 KB receive buffer. "Default" lets the usual rule decide where memory comes from:
# anything of 16 KB or more goes to the big external RAM (PSRAM), small pieces stay in the fast
# internal RAM, and when internal RAM runs short the external RAM is used instead of failing.
# (The setting before, "internal", took all of it from the small internal RAM.)
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
